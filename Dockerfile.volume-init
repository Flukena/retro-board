FROM alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6

# The immutable base may lag Alpine's security repository between image
# releases. This one-shot image has build-time network access only; the
# resulting init container itself runs with network_mode: none.
RUN apk upgrade --no-cache

# Safe when invoked directly. Compose explicitly and temporarily overrides
# this to root while granting only CHOWN and disabling networking.
USER 65534:65534
