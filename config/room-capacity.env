# 32 connected clients: 10 Hz motion + up to 17 Hz small geometry edits each.
# Message fanout is charged once per recipient. Keep byte/memory safeguards.
YJS_MAX_CONNECTIONS_PER_ROOM=32
YJS_MAX_CONNECTIONS_PER_IP=64
YJS_ROOM_WS_BURST_MESSAGES=2048
YJS_ROOM_WS_MESSAGES_PER_SECOND=1024
YJS_GLOBAL_WS_BURST_MESSAGES=4096
YJS_GLOBAL_WS_MESSAGES_PER_SECOND=2048
YJS_WS_EGRESS_CONNECTION_BURST_MESSAGES=2048
YJS_WS_EGRESS_CONNECTION_MESSAGES_PER_SECOND=1024
YJS_WS_EGRESS_ROOM_BURST_MESSAGES=65536
YJS_WS_EGRESS_ROOM_MESSAGES_PER_SECOND=32768
YJS_WS_EGRESS_GLOBAL_BURST_MESSAGES=131072
YJS_WS_EGRESS_GLOBAL_MESSAGES_PER_SECOND=65536
YJS_WS_UPGRADE_ROOM_BURST=64
YJS_WS_UPGRADES_PER_ROOM_PER_MINUTE=60
YJS_WS_UPGRADE_IP_BURST=80
YJS_WS_UPGRADES_PER_IP_PER_MINUTE=120
YJS_SESSION_EXCHANGE_BURST=64
YJS_SESSION_EXCHANGES_PER_MINUTE=120
YJS_ROOM_MAX_UNCOMPACTED_UPDATES=65536
