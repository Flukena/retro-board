# ---- build stage --------------------------------------------------------
# Compiles the React app to static assets with Vite. Build-time VITE_* values
# are supplied explicitly through build args instead of copying .env files.
# VITE_YJS_PORT tells the bundle which host port exposes the yjs relay.
FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf AS build

WORKDIR /app

RUN apk upgrade --no-cache

COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

ARG VITE_YJS_PORT=1234
ENV VITE_YJS_PORT=${VITE_YJS_PORT}

COPY --chown=node:node . .
RUN chown node:node /app
USER node
RUN npm run build

# ---- runtime stage ------------------------------------------------------
# Plain nginx serving the built bundle. Smaller and faster than `vite preview`.
FROM nginxinc/nginx-unprivileged:1.30.6-alpine@sha256:f5116ed4606f3eb015dd4a8e28cb9b351476dc0ad4bc6e9f93b19cec130cdf03 AS runtime

# nginx 1.30.7 fixes CVE-2026-113425, -121810, -123007, -123633 and -123634
# (nginx.org security advisories). Until the base image ships it, take the same
# signed nginx.org packages the base installs (its signing key is already in
# /etc/apk/keys). Drop this block when the base tag moves to 1.30.7 or later.
ARG NGINX_PACKAGE_VERSION=1.30.7-r1
ARG NJS_PACKAGE_VERSION=1.30.7.1.0.2-r1

USER root
RUN apk upgrade --no-cache \
 && alpine_release="$(grep -oE '^[0-9]+[.][0-9]+' /etc/alpine-release)" \
 && apk add --no-cache --repository "https://nginx.org/packages/alpine/v${alpine_release}/main" \
      "nginx=${NGINX_PACKAGE_VERSION}" \
      "nginx-module-geoip=${NGINX_PACKAGE_VERSION}" \
      "nginx-module-image-filter=${NGINX_PACKAGE_VERSION}" \
      "nginx-module-xslt=${NGINX_PACKAGE_VERSION}" \
      "nginx-module-njs=${NJS_PACKAGE_VERSION}" \
 && find /etc/nginx -name '*.apk-new' -delete
USER 101

COPY --chown=101:101 --from=build /app/dist /usr/share/nginx/html
COPY --chown=101:101 nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
