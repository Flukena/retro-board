FROM node:24-alpine@sha256:e67514e5d0f6c46656005e1b693b2ec9d52e80b641307de684d4a015ba7a4eaf

WORKDIR /app

# Pull fixed Alpine packages published after the immutable base digest. The
# digest pins the upstream filesystem; this explicit upgrade closes the gap
# between Node image releases and Alpine security repository updates.
RUN apk upgrade --no-cache

# Install only the runtime deps the yjs server needs (yjs, y-websocket,
# y-leveldb, ws). package-lock.json is included so installs are deterministic.
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

# Server entrypoint and its shared pure domain modules.
COPY --chown=node:node yjs-server.mjs ./
COPY --chown=node:node src/board-geometry.js src/move-concealment.js src/board-visibility.js src/board-ownership.js src/zone-actions.js src/security-boundaries.js src/vote-finalization.js src/vote-results.js src/vote-ranking.js src/canonical-votes.js src/awareness-liveness.js src/vote-result-participants.js src/comment-schema.js src/zone-title.js src/relay-lifecycle.js src/relay-vote-maintenance.js src/relay-rejection-counters.js src/relay-config.js src/relay-rate-bucket.js src/relay-http.js src/relay-uploads.js src/relay-log-id.js src/relay-room-registry.js src/relay-maintenance.js ./src/

# Named volumes inherit these ownership bits on first creation, allowing the
# runtime to persist data without retaining root inside the container.
RUN mkdir -p /data /uploads \
    && chown -R node:node /app /data /uploads

ENV YJS_PORT=1234
ENV YJS_HOST=0.0.0.0
ENV YJS_DB_DIR=/data
ENV YJS_UPLOADS_DIR=/uploads
ENV YJS_HEAP_LIMIT_MIB=384
ENV YJS_SEMI_SPACE_LIMIT_MIB=16
ENV NODE_OPTIONS="--max-old-space-size=${YJS_HEAP_LIMIT_MIB} --max-semi-space-size=${YJS_SEMI_SPACE_LIMIT_MIB}"

EXPOSE 1234

# LevelDB lives on a named volume mounted at /data, uploaded images on a
# separate one at /uploads, so both survive restarts.
USER node
CMD ["node", "yjs-server.mjs"]
