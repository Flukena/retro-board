FROM node:26-alpine@sha256:40cd011b55415bc894e45b02fdd5a5dfde056921b7d23a64c74f80497af48797

WORKDIR /app

# Pull fixed Alpine packages published after the immutable base digest. The
# digest pins the upstream filesystem; this explicit upgrade closes the gap
# between Node image releases and Alpine security repository updates.
RUN apk upgrade --no-cache

# Install only the runtime deps the yjs server needs (yjs, y-websocket,
# y-leveldb, ws). package-lock.json is included so installs are deterministic.
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

# Server entrypoint and its shared pure domain modules.
COPY --chown=node:node yjs-server.mjs ./
COPY --chown=node:node \
    src/domain/awareness-liveness.js src/domain/board-coordinates.js src/domain/board-geometry.js \
    src/domain/board-ownership.js src/domain/board-reconciliation.js src/domain/board-state.js \
    src/domain/board-visibility.js src/domain/canonical-votes.js src/domain/comment-schema.js \
    src/domain/csv-import.js src/domain/import-schema.js src/domain/item-appearance.js \
    src/domain/minimap.js src/domain/move-concealment.js src/domain/move-reparenting.js \
    src/domain/pending-local-items.js src/domain/public-board-permissions.js src/domain/public-wall-contract.js \
    src/domain/public-wall-image-source.js src/domain/public-zone-layout.js src/domain/security-boundaries.js \
    src/domain/template-model.js src/domain/template-store.js src/domain/viewport-framing.js \
    src/domain/viewport-limits.js src/domain/viewport-zoom.js src/domain/vote-finalization.js \
    src/domain/vote-ownership.js src/domain/vote-ranking.js src/domain/vote-result-participants.js \
    src/domain/vote-results.js src/domain/vote-session-lifecycle.js src/domain/vote-timing.js \
    src/domain/voting-results.js src/domain/z-order.js src/domain/zone-actions.js \
    src/domain/zone-title.js \
    ./src/domain/

COPY --chown=node:node \
    src/server/public-restore-images.js src/server/public-upload-backup.js src/server/public-wall-config.js \
    src/server/public-wall-history.js src/server/public-wall-prune.js src/server/public-wall-restore.js \
    src/server/public-wall-snapshot.js src/server/relay-awareness-fanout.js src/server/relay-config.js src/server/relay-http.js \
    src/server/relay-lifecycle.js src/server/relay-local-files.js src/server/relay-log-id.js \
    src/server/relay-maintenance.js src/server/relay-protocol.js src/server/relay-public-wall.js \
    src/server/relay-rate-bucket.js src/server/relay-rejection-counters.js src/server/relay-room-registry.js \
    src/server/relay-session.js src/server/relay-uploads.js src/server/relay-vote-maintenance.js \
    ./src/server/

COPY --chown=node:node scripts/public-wall-restore.mjs scripts/public-wall-restore.sh ./scripts/

# Named volumes inherit these ownership bits on first creation, allowing the
# runtime to persist data without retaining root inside the container.
RUN mkdir -p /data /uploads \
    && chown -R node:node /app /data /uploads

ENV YJS_PORT=1234
ENV YJS_HOST=0.0.0.0
ENV YJS_DB_DIR=/data
ENV YJS_UPLOADS_DIR=/uploads
ENV YJS_HEAP_LIMIT_MIB=384
ENV YJS_SEMI_SPACE_LIMIT_MIB=16
ENV NODE_OPTIONS="--max-old-space-size=${YJS_HEAP_LIMIT_MIB} --max-semi-space-size=${YJS_SEMI_SPACE_LIMIT_MIB}"

EXPOSE 1234

# LevelDB lives on a named volume mounted at /data, uploaded images on a
# separate one at /uploads, so both survive restarts.
USER node
CMD ["node", "yjs-server.mjs"]
