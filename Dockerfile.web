FROM node:26-alpine@sha256:143494b1da2945f061539253adc65e4f1569ddf07da2d384c022c791a9d90a4a

WORKDIR /app

RUN apk upgrade --no-cache

# Cache npm install on a separate layer. The full source tree is bind-mounted
# at runtime via docker compose, but baking in node_modules at build time
# avoids reinstalling on every container start.
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

COPY --chown=node:node . .
RUN chown -R node:node /app

EXPOSE 5173

# Vite dev server with HMR. --host 0.0.0.0 makes it reachable from outside
# the container only when docker-compose explicitly sets VITE_DEV_HOST.
USER node
CMD ["npm", "run", "dev"]
